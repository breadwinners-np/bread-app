# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.
#
# REQUIRED. The admin app reads and writes the same Supabase project as the
# storefront: they share one database, so copy these two values across from
# apps/storefront/.env.local rather than creating a second project.
#
# The app throws on startup if these are missing, on purpose — without them it
# would otherwise render a working-looking bakery with no orders and no money.

# Project settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
# Project settings -> API Keys. The Secret key (older projects call it
# service_role). SECRET — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
