# Copy this file to .env.local and fill in real values. .env.local is
# gitignored at the repo root — never commit real keys.

# Project settings -> Data API, for the URL.
# Project settings -> API Keys, for the two keys below. Newer Supabase
# projects label these "Publishable key" and "Secret key"; older ones show
# "anon public" and "service_role" — same two keys, same slots here either way.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. Safe to expose to the browser — RLS decides what it can see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key: SECRET. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Not used yet — payment is mocked until these are wired in.
# Paystack dashboard -> Settings -> API Keys & Webhooks. Use TEST keys only
# for this demo; never put a live secret key in this app.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
